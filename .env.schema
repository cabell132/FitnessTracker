# Credentials are optional here so database-only and offline commands can run.
# Config.from_env validates the credentials required by application commands.
# Unknown local keys are sensitive too.
# @defaultSensitive=true @defaultRequired=false
# ---

# True Coach account email.
# @sensitive @type=email
EMAIL=

# @sensitive
TRUECOACH_PASSWORD=

# @sensitive
HEVY_API_KEY=

# VeSync account used to read smart scale measurements.
# @sensitive @type=email
VESYNC_EMAIL=

# @sensitive
VESYNC_PASSWORD=

# Use the account owner's athlete body-fat calculation during scale sync.
# @public @type=boolean
VESYNC_ATHLETE_MODE=true

# Legacy fallback. Refreshing Hevy credentials live in .hevy-web-auth.json.
# @sensitive
HEVY_WEB_API_KEY=

# Optional override for the rotating Hevy credential store location.
# @sensitive
HEVY_WEB_AUTH_PATH=

# @sensitive
OPENAI_API_KEY=

# @sensitive
DROPBOX_ACCESS_TOKEN=

# SQLAlchemy URL, which can contain a database password.
# @sensitive
DATABASE_URL=sqlite:///fitness_tracker.db

# Used by docker-compose.postgres.yml when provisioning PostgreSQL.
# @sensitive
FITNESS_TRACKER_POSTGRES_PASSWORD=

# @sensitive
LANGCHAIN_API_KEY=

# @sensitive
LANGSMITH_API_KEY=

# @public @type=url
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# @public @type=boolean
LANGSMITH_TRACING=false

# @public
LANGCHAIN_PROJECT=fitness-tracker
